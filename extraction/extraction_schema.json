        "primary_system_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_pharmaceutical_ingredient": {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "api_amount_mg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "bcs_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "log_p": {
              "type": [
                "number",
                "null"
              ]
            },
            "molecular_weight_da": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
