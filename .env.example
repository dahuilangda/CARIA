# Extraction harness configuration (copy to `.env`).
# Works with any OpenAI-compatible /v1/chat/completions endpoint;
# vision-capable models can additionally read article figures.

EXTRACTION_BASE_URL=http://localhost:8000/v1
EXTRACTION_API_KEY=your-token-here
EXTRACTION_MODEL=your-model-id
EXTRACTION_TIMEOUT=180
# Optional literature-discovery channel (PubMed + Tavily):
# TAVILY_API_KEY=your-tavily-key
